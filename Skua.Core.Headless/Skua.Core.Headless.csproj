<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless AQW protocol client and world model.
    Platform neutral on purpose: no Android, Avalonia, Flash or Skua.Core dependency, so it builds and
    tests on any desktop OS and can be referenced from the Android app later.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <RootNamespace>Skua.Core.Headless</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Skua.Core.Headless.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
