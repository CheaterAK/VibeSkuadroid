<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Script-engine hosting for Android: which assemblies scripts compile against and how they are read from APK
    assets, the in-process cache that keeps identical assemblies from being loaded twice, and the adapter that runs
    Skua.Core (HeadlessSkuaSession) behind IScriptHost. Platform neutral and tested on Linux.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Skua.App.Droid.Scripting</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.App.Droid.Core\Skua.App.Droid.Core.csproj" />
    <!-- The built-in plugins' game-side halves; the adapter creates them on its session (IPluginBackendSource). -->
    <ProjectReference Include="..\Skua.App.Droid.Plugins\Skua.App.Droid.Plugins.csproj" />
    <ProjectReference Include="..\..\Skua.Core\Skua.Core.csproj" />
    <!-- HeadlessSkuaSession: Skua.Core's services on the headless Flash bridge (brings Skua.Core.Headless.Flash). -->
    <ProjectReference Include="..\..\Skua.Core.Headless.Host\Skua.Core.Headless.Host.csproj" />
    <!-- Scripts need System.Windows.Forms types to compile at all; this shim provides them off Windows. -->
    <ProjectReference Include="..\..\Skua.Compat.WinForms\Skua.Compat.WinForms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Skua.App.Droid.Tests" />
  </ItemGroup>

</Project>
