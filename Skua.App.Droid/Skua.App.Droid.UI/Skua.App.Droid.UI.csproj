<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia 12 views for the Android app (phone-first, dark). Plain net10.0 so the same views run in the Linux
    desktop preview host and in headless UI tests; the Android head only adds the platform glue.
    All bindings are compiled (AvaloniaUseCompiledBindingsByDefault in Directory.Build.props), so a binding to a
    missing ViewModel member is a build error, not a silent blank on the phone.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Skua.App.Droid.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.App.Droid.Core\Skua.App.Droid.Core.csproj" />
  </ItemGroup>

</Project>
