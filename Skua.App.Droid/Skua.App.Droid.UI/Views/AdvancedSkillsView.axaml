<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Skua.App.Droid.Core.ViewModels"
             xmlns:v="using:Skua.App.Droid.UI.Views"
             x:Class="Skua.App.Droid.UI.Views.AdvancedSkillsView"
             x:DataType="vm:AdvancedSkillsViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:SkillRotationEditorViewModel"><v:SkillRotationEditorView /></DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
    <!-- Classes -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="12,8" IsVisible="{Binding IsListVisible}">
      <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,6">
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Summary}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding SearchText}" PlaceholderText="Search classes" TextInputOptions.AutoCapitalization="False" />
          <Button Grid.Column="1" Classes="small primary" Margin="8,0,0,0" Content="New" Command="{Binding NewCommand}" />
        </Grid>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <ListBox Grid.Row="1" ItemsSource="{Binding Classes}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SkillClassItem">
            <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Padding="2,0" Command="{Binding Owner.OpenClassCommand}" CommandParameter="{Binding}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted" Text="{Binding ModesText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1" Classes="status" VerticalAlignment="Center" IsVisible="{Binding HasBadge}">
                  <TextBlock FontSize="11" HorizontalAlignment="Center" Text="{Binding Badge}" />
                </Border>
              </Grid>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Scripts use these rotations (UserAdvancedSkills.json). Community updates from the script sync keep your edits." />
        <Button Classes="small danger" HorizontalAlignment="Left" Content="Reset all to community" Command="{Binding AskResetCommand}" IsVisible="{Binding !ConfirmReset}" />
        <Border Classes="banner" Margin="0" IsVisible="{Binding ConfirmReset}">
          <StackPanel Spacing="6">
            <TextBlock TextWrapping="Wrap" FontSize="13" Text="Replace every rotation with the community version? Your edits and your own rotations are lost." />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Classes="small" Content="Cancel" Command="{Binding CancelResetCommand}" />
              <Button Classes="small danger" Content="Reset" Command="{Binding ResetAllCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- One class: its rotations -->
    <ScrollViewer IsVisible="{Binding IsClassVisible}">
      <StackPanel Margin="12,8">
        <TextBlock Classes="muted" TextWrapping="Wrap" Margin="2,0,0,8" Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Border Classes="banner" Margin="0,0,0,10" IsVisible="{Binding PendingDelete, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="6">
            <TextBlock TextWrapping="Wrap" FontSize="13" Text="{Binding DeletePrompt}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Classes="small" Content="Cancel" Command="{Binding CancelDeleteCommand}" />
              <Button Classes="small danger" Content="Delete" Command="{Binding ConfirmDeleteCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding SelectedSets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SkillSetRow">
              <Border Classes="card">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontWeight="Bold" FontSize="16" Text="{Binding Mode}" />
                    <Border Grid.Column="1" Classes="status">
                      <TextBlock FontSize="11" HorizontalAlignment="Center" Text="{Binding OriginText}" />
                    </Border>
                  </Grid>
                  <TextBlock Classes="mono" FontSize="13" Text="{Binding Skills}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding UseModeText}" />
                  <WrapPanel>
                    <Button Classes="small primary" Margin="0,0,8,4" Content="Edit" Command="{Binding Owner.EditCommand}" CommandParameter="{Binding}" />
                    <Button Classes="small" Margin="0,0,8,4" Content="Use community version" IsVisible="{Binding CanRestore}"
                            Command="{Binding Owner.RestoreCommand}" CommandParameter="{Binding}" />
                    <Button Classes="small danger" Margin="0,0,8,4" Content="Delete" Command="{Binding Owner.DeleteCommand}" CommandParameter="{Binding}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="small" HorizontalAlignment="Left" Content="Add a rotation for another mode" Command="{Binding NewCommand}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Margin="2,10,0,0"
                   Text="CoreBots picks the mode per slot (solo, farm, dodge, boss) in CoreBots options. A running script keeps the rotation it loaded; the next one it loads (or the next start) uses your changes." />
      </StackPanel>
    </ScrollViewer>

    <!-- The rotation editor -->
    <ContentControl IsVisible="{Binding IsEditorVisible}" Content="{Binding Editor}" />
  </Panel>
</UserControl>
