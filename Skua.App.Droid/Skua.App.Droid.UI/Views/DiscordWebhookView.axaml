<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Skua.App.Droid.Core.ViewModels"
             x:Class="Skua.App.Droid.UI.Views.DiscordWebhookView"
             x:DataType="vm:DiscordWebhookViewModel">
  <ScrollViewer>
    <StackPanel Margin="12,8">
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="caption" Text="WEBHOOK" />
          <TextBlock TextWrapping="Wrap" Text="{Binding StatusText}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !CanStore}"
                     Text="No secure storage on this device: a webhook URL cannot be stored." />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Paste the URL from Discord (channel settings, Integrations, Webhooks). It is a password for the channel: it is stored encrypted on this device, never shown again and never backed up." />
          <TextBox Text="{Binding UrlInput}" PlaceholderText="https://discord.com/api/webhooks/..." PasswordChar="•"
                   TextInputOptions.AutoCapitalization="False" TextInputOptions.ContentType="Url" IsEnabled="{Binding CanStore}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="small primary" Content="Save" Command="{Binding SaveUrlCommand}" />
            <Button Classes="small" Content="Send test" Command="{Binding SendTestCommand}" />
            <Button Classes="small danger" Content="Delete" Command="{Binding ForgetUrlCommand}" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Classes.error="{Binding IsError}" Classes.muted="{Binding !IsError}" Text="{Binding Message}"
                     IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="6">
          <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="Send to Discord" OffContent="Send to Discord" />
          <TextBlock Classes="caption" Text="EVENTS" />
          <CheckBox IsChecked="{Binding NotifyStarted}" Content="Script started" />
          <CheckBox IsChecked="{Binding NotifyStopped}" Content="Farming session concluded (time, gold, kills, drops, quests)" />
          <CheckBox IsChecked="{Binding NotifyCrashed}" Content="Script error (the script name only)" />
          <CheckBox IsChecked="{Binding NotifyRelogged}" Content="Kicked or disconnected, relogging" />
          <CheckBox IsChecked="{Binding NotifySchedulerPaused}" Content="Scheduler paused" />
          <CheckBox IsChecked="{Binding NotifyItemDrops}" Content="Watched items dropped or obtained" />
          <TextBlock Classes="caption" Text="WHAT CARDS SHOW" />
          <CheckBox IsChecked="{Binding IncludeCharacterName}" Content="Character name (off: VibeSkua Bot)" />
          <CheckBox IsChecked="{Binding IncludeMap}" Content="Map name" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Cards carry script, item and map names, counts and durations only; never your account name, password, login token or e-mail." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
